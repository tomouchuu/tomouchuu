{
  "name": "@tomouchuu/personal",
  "version": "11.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "bun run build && wrangler dev",
    "deploy": "bun run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "prepare": "bun run paraglide && (svelte-kit sync || echo '')",
    "paraglide": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
    "check": "bun run paraglide && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo",
    "check:watch": "bun run paraglide && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo --watch",
    "test:unit": "vitest",
    "test": "bun run test:unit -- --run"
  },
  "dependencies": {
    "@elysiajs/eden": "^1.4.9",
    "@inlang/paraglide-js": "^2.25.4",
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.49.0",
    "@sinclair/typebox": "^0.34.52",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/svelte-query": "^6.3.0",
    "@tanstack/svelte-query-devtools": "^6.3.0",
    "@types/bun": "^1.4.2",
    "@types/node": "26.2.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/browser": "^5.0.3",
    "@vitest/browser-playwright": "^5.0.3",
    "bits-ui": "^2.19.3",
    "clsx": "^2.1.1",
    "elysia": "^1.4.30",
    "mode-watcher": "^1.1.0",
    "playwright": "^1.63.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "8.3.1",
    "vite-plugin-devtools-json": "^1.1.0",
    "vitest": "^5.0.3",
    "vitest-browser-svelte": "^3.1.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "wrangler": "^4.145.0"
  },
  "overrides": {
    "cookie": "1.1.1",
    "picomatch": "4.0.5",
    "vite": "8.3.1"
  }
}
