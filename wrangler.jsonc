{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tomouchuu",
  "main": ".svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2026-08-07",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare"
  },
  "routes": [
    {
      "pattern": "tomo.uchuu.dev",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
